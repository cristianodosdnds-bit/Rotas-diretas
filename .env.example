# Copie este arquivo para ".env" e preencha com seus dados reais.
# NUNCA suba o arquivo ".env" (com senhas reais) para o GitHub.

# --- Servidor ---
PORT=4000

# --- Banco de dados MySQL (gerenciado pelo HeidiSQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque_esta_senha
DB_NAME=rotas_expressas

# --- Segurança ---
# Chave secreta para assinar os tokens de login (JWT). Troque por um texto longo e aleatório.
JWT_SECRET=troque_esta_chave_super_secreta
# Tempo de validade do login (ex: 12h, 7d)
JWT_EXPIRES_IN=7d

# API Key que o app (frontend) deve enviar em toda requisição, no header "x-api-key".
# Protege o backend contra acessos indevidos vindos de fora do seu app.
APP_API_KEY=troque_esta_apikey_do_backend

# --- API externa de geocodificação (usada depois, para converter endereço em lat/lng) ---
GEOCODING_API_KEY=sua_chave_do_google_ou_outro_provedor
